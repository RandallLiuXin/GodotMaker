{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RandallLiuXin/GodotMaker/skills/assets/_shared/schema/asset-skill-request.schema.json",
  "title": "Asset Skill Request",
  "description": "Unified invocation contract for any first-class asset skill. Carries no pipeline, tag, stage, or manifest state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_type", "asset_id", "brief"],
  "allOf": [
    {
      "if": {
        "properties": {"asset_type": {"const": "scene-prop-set"}},
        "required": ["asset_type"]
      },
      "then": {
        "required": ["spec"],
        "properties": {
          "spec": {"$ref": "#/$defs/scenePropSetSpec"}
        }
      }
    }
  ],
  "properties": {
    "asset_type": {
      "type": "string",
      "enum": [
        "background-map",
        "character-bundle",
        "fx-bundle",
        "ui-kit",
        "card-kit",
        "compact-prop-pack",
        "platform-strip",
        "scene-prop-set",
        "screen-reference",
        "tileset"
      ]
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "brief": {
      "type": "string",
      "pattern": "\\S"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["canonical", "style", "screen"]
          },
          "path": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "provider": {
      "type": "string",
      "enum": ["native", "codex", "gemini", "openai"]
    },
    "spec": {
      "type": "object"
    }
  },
  "$defs": {
    "scenePropSetSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "atlas", "slots"],
      "properties": {
        "version": {"const": 1},
        "atlas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "rect", "source"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(?!.*[\\\\/:;<>\"|?*\\x00-\\x1F])(?!\\s)(?!.*\\s$)(?!.*\\.$).+$"
              },
              "rect": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {"type": "integer", "minimum": 0},
                  {"type": "integer", "minimum": 0},
                  {"type": "integer", "minimum": 1},
                  {"type": "integer", "minimum": 1}
                ]
              },
              "source": {"type": "string", "pattern": "\\S"},
              "pivot": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    }
  }
}
