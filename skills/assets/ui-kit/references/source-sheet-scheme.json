        {"name": "confirm", "label": "confirm action", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_confirm"]},
        {"name": "warning", "label": "warning status", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_warning"]},
        {"name": "information", "label": "information status", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_information"]},
        {"name": "settings", "label": "settings action", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_settings"]},
        {"name": "add", "label": "add action", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_add"]},
        {"name": "remove", "label": "remove action", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_remove"]},
        {"name": "lock", "label": "locked state", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_lock"]},
        {"name": "unlock", "label": "unlocked state", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_unlock"]},
        {"name": "checkbox_checked", "label": "checked checkbox", "target_size": [40, 40], "kind": "icon", "runtime_names": ["icon_checkbox_checked", "checkbox_checked"]},
        {"name": "checkbox_unchecked", "label": "unchecked checkbox", "target_size": [40, 40], "kind": "icon", "runtime_names": ["icon_checkbox_unchecked", "checkbox_unchecked"]},
        {"name": "radio_selected", "label": "selected radio control", "target_size": [40, 40], "kind": "icon", "runtime_names": ["icon_radio_selected"]},
        {"name": "radio_unselected", "label": "unselected radio control", "target_size": [40, 40], "kind": "icon", "runtime_names": ["icon_radio_unselected"]},
        {"name": "status", "label": "general status indicator", "target_size": [128, 128], "kind": "icon", "runtime_names": ["icon_status"]},
