        {"name": "slider_grabber", "label": "slider grabber", "target_size": [48, 48], "kind": "icon", "runtime_names": ["hslider_grabber", "vslider_grabber"]},
        {"name": "slider_grabber_highlight", "label": "highlighted slider grabber", "target_size": [48, 48], "kind": "icon", "runtime_names": ["hslider_grabber_highlight", "vslider_grabber_highlight"]},
        {"name": "slider_grabber_disabled", "label": "disabled slider grabber", "target_size": [48, 48], "kind": "icon", "runtime_names": ["hslider_grabber_disabled", "vslider_grabber_disabled"]}
      ]
