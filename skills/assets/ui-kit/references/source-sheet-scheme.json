        },
        {
          "name": "panel_raised",
          "label": "square reusable raised panel frame with a continuous undecorated center",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "panel_surface",
          "runtime_styleboxes": [
            {"output_name": "panel_raised", "state": "normal", "tint": "surface_raised"}
          ]
        },
        {
          "name": "tab_selected",
          "label": "square tintable selected tab surface with an undecorated stretchable center",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "tab_surface",
          "runtime_styleboxes": [
            {"output_name": "tab_selected", "state": "pressed", "tint": "primary"},
            {"output_name": "tab_hovered", "state": "hover", "tint": "primary"}
          ]
        },
        {
          "name": "tab_unselected",
          "label": "square tintable unselected tab surface with an undecorated stretchable center",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "tab_surface",
          "runtime_styleboxes": [
            {"output_name": "tab_unselected", "state": "normal", "tint": "surface"}
          ]
        }
      ]
    },
    {
      "id": "icons",
      "source_name": "icons_source.png",
      "provider_grid": {"columns": 6, "rows": 4},
      "atlas": {"max_width": 880, "gutter": 16},
      "components": [
        {"name": "arrow_left", "label": "left arrow", "target_size": [32, 32], "kind": "icon", "runtime_names": ["icon_left_arrow"]},
        {"name": "arrow_right", "label": "right arrow", "target_size": [32, 32], "kind": "icon", "runtime_names": ["icon_right_arrow", "icon_submenu", "form_submenu_arrow"]},
        {"name": "arrow_up", "label": "up arrow", "target_size": [32, 32], "kind": "icon", "runtime_names": ["icon_up_arrow"]},
