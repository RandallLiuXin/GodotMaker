            {"output_name": "panel_base", "state": "normal", "tint": "surface"},
            {"output_name": "popup_menu_panel", "state": "normal", "tint": "surface"},
            {"output_name": "tooltip_panel", "state": "normal", "tint": "surface_raised"}
