{
  "version": 5,
  "background": {
    "color": "#FF00FF",
    "flat": true,
    "reserved_for_color_key": true,
    "forbid_in_art": true
  },
  "composition": {
    "separated_components": true,
    "minimum_gap_px": 24,
    "reading_order": "row_major",
    "forbid_canvas_edge_contact": true,
    "forbid_scene_or_screen_mockup": true,
    "forbid_text_and_logos": true
  },
  "geometry_profiles": {
    "rounded_surface": {
      "patch_size": [96, 96],
      "border": [10, 10, 10, 10],
      "content_margin": [16, 10, 16, 10],
      "expand_margin": [0, 0, 0, 0],
      "axis_stretch": {"horizontal": "stretch", "vertical": "stretch"},
      "safe_center": [10, 10, 76, 76],
      "preview_sizes": [[160, 48], [360, 64]]
    },
    "panel_surface": {
      "patch_size": [96, 96],
      "border": [16, 16, 16, 16],
      "content_margin": [24, 24, 24, 24],
      "expand_margin": [0, 0, 0, 0],
      "axis_stretch": {"horizontal": "stretch", "vertical": "stretch"},
      "safe_center": [16, 16, 64, 64],
      "preview_sizes": [[240, 160], [640, 400]]
    },
    "tab_surface": {
      "patch_size": [96, 96],
      "border": [8, 8, 8, 8],
      "content_margin": [16, 8, 16, 8],
      "expand_margin": [0, 0, 0, 0],
      "axis_stretch": {"horizontal": "stretch", "vertical": "stretch"},
      "safe_center": [8, 8, 80, 80],
      "preview_sizes": [[120, 40], [280, 56]]
    }
  },
  "sheets": [
    {
      "id": "surface_patches",
      "source_name": "surface_patches_source.png",
      "provider_grid": {"columns": 4, "rows": 2},
      "atlas": {"max_width": 464, "gutter": 16},
      "components": [
        {
          "name": "button_normal",
          "label": "square tintable button surface in its normal state",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "rounded_surface",
          "runtime_styleboxes": [
            {"output_name": "button_normal", "state": "normal", "tint": "surface_raised"},
            {"output_name": "primary_normal", "state": "normal", "tint": "primary"},
            {"output_name": "secondary_normal", "state": "normal", "tint": "secondary"},
            {"output_name": "danger_normal", "state": "normal", "tint": "danger"}
          ]
        },
        {
          "name": "button_hover",
          "label": "square tintable button surface in its highlighted hover state",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "rounded_surface",
          "runtime_styleboxes": [
            {"output_name": "button_hover", "state": "hover", "tint": "surface_raised"},
            {"output_name": "primary_hover", "state": "hover", "tint": "primary"},
            {"output_name": "secondary_hover", "state": "hover", "tint": "secondary"},
            {"output_name": "danger_hover", "state": "hover", "tint": "danger"}
          ]
        },
        {
          "name": "button_pressed",
          "label": "square tintable button surface in its depressed pressed state",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "rounded_surface",
          "runtime_styleboxes": [
            {"output_name": "button_pressed", "state": "pressed", "tint": "surface_raised"},
            {"output_name": "primary_pressed", "state": "pressed", "tint": "primary"},
            {"output_name": "secondary_pressed", "state": "pressed", "tint": "secondary"},
            {"output_name": "danger_pressed", "state": "pressed", "tint": "danger"}
          ]
        },
        {
          "name": "button_disabled",
          "label": "square tintable button surface in its muted disabled state",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "rounded_surface",
          "runtime_styleboxes": [
            {"output_name": "button_disabled", "state": "disabled", "tint": "surface_raised"},
            {"output_name": "primary_disabled", "state": "disabled", "tint": "primary"},
            {"output_name": "secondary_disabled", "state": "disabled", "tint": "secondary"},
            {"output_name": "danger_disabled", "state": "disabled", "tint": "danger"}
          ]
        },
        {
          "name": "panel_base",
          "label": "square reusable base panel frame with a continuous undecorated center",
          "target_size": [96, 96],
          "kind": "surface",
          "geometry_profile": "panel_surface",
